# 服务端口配置
# 使用 npm run dev:full 启动所有服务

# 前端开发服务器端口
VITE_DEV_PORT=3004

# Node.js Mock API 服务器端口
MOCK_API_PORT=3001

# Python Flask 后端端口
FLASK_PORT=5000

# E2E 测试服务器端口
E2E_PORT=3004

# API 代理配置（指向 Python 后端）
VITE_API_PROXY=http://localhost:5000

# Mock API 代理配置
VITE_MOCK_API_PROXY=http://localhost:3001

# ============================================
# 敏感配置（请复制到 .env 文件中填写真实值）
# 注意：.env 文件已在 .gitignore 中，不会被提交
# ============================================

# JWT Secret Key (生产环境必须修改!)
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=CHANGE_ME_TO_A_STRONG_RANDOM_KEY_AT_LEAST_32_CHARS

# [FR-024] CORS 白名单 (逗号分隔)
CORS_ALLOWED_ORIGINS=http://localhost:3004,http://127.0.0.1:3004

# DeepSeek API配置
VITE_DEEPSEEK_API_KEY=your_deepseek_api_key_here

# 智谱AI API配置
VITE_ZHIPU_API_KEY=your_zhipu_api_key_here

# 飞书开放平台配置
VITE_FEISHU_APP_ID=your_feishu_app_id_here
VITE_FEISHU_APP_SECRET=your_feishu_app_secret_here
VITE_FEISHU_ACCESS_TOKEN=your_feishu_access_token_here

# ============================================
# 部署级开关（实例属性 —— 与装哪些 app 无关）
# 详见 docs/DEPLOYMENT_STANDARDS.md §9.2
# ============================================

# 启用哪些应用包（白名单，逗号分隔；空 = legacy 模式，不加载任何应用）
# ENABLED_APPS=warehouse,tms

# 库形态（实例拓扑属性，roadmap v1.32.0 §6.2.3）
#   0 = 合并形态（默认）：各应用表同落 platform.db + table_prefix 命名空间
#   1 = 独立形态：各应用表落 data/<app_id>.db
# 往已建实例加 app 不改变取值；仅"合并交付 ↔ 单应用独立交付"变化时才翻转
# APP_DB_ROUTING=0

# 实例展示名 —— 前端左上角与登录页标题（GET /api/v2/meta/instance）
# 不配置时：恰好启用 1 个 app → 用该 app 的 app.yaml name；否则用默认名
# PLATFORM_DISPLAY_NAME=架构数据服务管理

# 平台模块黑名单（逗号分隔，空 = 全部启用；roadmap v1.32.0 §6.2.4）
# 当前可关闭：tasks（任务体系）。rules（规则体系）暂无可关闭入口，写了无效果
#   ——/health 的 ineffective_platform_modules 字段会报出
# DISABLED_PLATFORM_MODULES=tasks
