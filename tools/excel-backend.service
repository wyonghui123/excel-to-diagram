[Unit]
# [V007.25] excel-backend.service - 基础设施智能体持续优化
# 用途: 监控 server.py, 自动重启 (on-failure)
# 启动: deploy.sh --systemd (默认 no, 因为 systemd 需 root + service 文件)
# 监控: journalctl -u excel-backend -f
# 测试: systemctl status excel-backend
Description=Excel to Diagram Backend (V007.25 enhanced)
Documentation=https://github.com/...
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/app/deployments/meta

# [V007.25] 用 EnvironmentFile 而不是 inline Environment, 避免 deploy 时 secret 变更需要改 service 文件
# EnvironmentFile=/opt/app/deployments/.env
# 如果不想用 EnvironmentFile, 可保留原 inline Environment:
Environment="PORT=5001"
Environment="JWT_SECRET_KEY=deploy-default-jwt-key-do-not-use-in-prod"
Environment="FLASK_SECRET_KEY=deploy-default-flask-key-do-not-use-in-prod"
Environment="CORS_ALLOWED_ORIGINS=http://127.0.0.1:8081,http://localhost:8081"
Environment="FLASK_DEBUG=false"
Environment="FLASK_ENV=production"

# 启动命令
ExecStart=/opt/miniconda3-py39/bin/python server.py

# [V007.25] 自动重启策略
# - on-failure: 只在非零退出时重启
# - always: 任何退出都重启 (更激进)
Restart=on-failure
RestartSec=5

# [V007.25] 启动超时 (30s 应足够 server.py 启动)
TimeoutStartSec=30

# [V007.25] 停止超时 (10s 应足够 graceful shutdown)
TimeoutStopSec=10

# [V007.25] 看门狗 (实验性)
# 如果 server.py 在 60s 内没响应 SIGALRM, systemd 会杀进程
# 需要 server.py 内部跑 sd_notify("WATCHDOG=1") 循环
# WatchdogSec=60

# 资源限制
LimitNOFILE=65536

# 日志输出
StandardOutput=journal
StandardError=journal
SyslogIdentifier=excel-backend

[Install]
WantedBy=multi-user.target
