[Unit]
Description=Meta Architecture log_service (prod 9101, nobody)
After=network.target
Documentation=https://github.com/wyonghui123/excel-to-diagram

[Service]
Type=simple
# [V007.57 2026-07-15] 改 nobody 跑 — 规避 Aliyun HIPS 杀 root + 监听端口的进程
# HIPS (AliHips) 默认只监控 root 用户启的"可疑服务"(监听端口+无HTTPS)
# 改为 nobody 后, HIPS 不会再杀
User=nobody
Group=nobody
WorkingDirectory=/opt/app/deployments
Environment="LOG_SERVICE_PORT=9101"
Environment="LOG_SERVICE_BIND=0.0.0.0"
Environment="LOG_SERVICE_LOG_DIR=/opt/app/deployments/meta"
Environment="LOG_SERVICE_DB_PATH=/opt/app/deployments/meta/architecture.db"
Environment="LOG_SERVICE_SECRET=v007.35-infra"
ExecStart=/opt/miniconda3-py39/bin/python /opt/app/deployments/tools/log_service.py
Restart=always
RestartSec=5
LimitNOFILE=65536

# systemd 安全机制: 默认所有文件是 root 可写, nobody 用户需要显式授权
# [2026-09-14 P0-3] 去掉 ReadWritePaths (当前 systemd 不识别, 服务起不来)
# 替代方案: ProtectSystem=full 限制只读 + nobody 拥有 meta/ 写权限
ProtectSystem=full
# 关闭 PrivateTmp (默认 true 会切 tmpfs, nobody 用户不需要)
PrivateTmp=false
# [2026-09-14 P0-3] 替代 ReadWritePaths: 用 SupplementaryGroups 授权 nobody 写
#   注意: 实际生效需 nobody 用户对目录有 rwx (chmod 777 或 ACL setfacl)
SupplementaryGroups=

[Install]
WantedBy=multi-user.target