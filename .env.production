# Production Environment Configuration
# Copy this file to .env and update values for production deployment

# JWT Secret Key - MUST be changed for production!
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=CHANGE_ME_TO_A_STRONG_RANDOM_KEY_AT_LEAST_32_CHARS

# Flask port
FLASK_PORT=3010

# [FR-024] CORS 白名单 (逗号分隔, 生产环境必须配置)
# 未配置 + FLASK_DEBUG=false → 所有跨域请求被拒绝
CORS_ALLOWED_ORIGINS=https://your-production-domain.com

# 实例展示名 —— 前端左上角与登录页标题（GET /api/v2/meta/instance）
# 不配置时：恰好启用 1 个 app → 用该 app 的 app.yaml name；否则用默认名
PLATFORM_DISPLAY_NAME=

# 平台模块启用开关（roadmap v1.32.0 §6.2.4）—— 黑名单，逗号分隔，空 = 全部启用
# 当前可关闭：tasks（任务体系）。rules（规则体系）暂无可关闭入口，写了不报错但无效果
#   ——/health 的 ineffective_platform_modules 字段会如实报出
# 例：DISABLED_PLATFORM_MODULES=tasks
#   → 路由侧：每次启动生效，task/task_inbox/task_decision 三个 blueprint 不注册（真 404）
#   → 菜单侧：仅对"尚未跑过任务菜单种子"的实例生效；已跑过的实例菜单行仍在，
#     需一次性执行：
#       UPDATE menus SET show_in_sidebar=0 WHERE menu_code IN
#       ('task-management','task-definitions','task-queues','task-executions','ai-async-tasks');
# 注意：调度器（task_scheduler / platform_tick）不受本开关控制 —— 它是共享基础设施
#   （审计归档 / 导入队列 / DB 维护都挂在上面），关模块 != 关调度
DISABLED_PLATFORM_MODULES=
