      "healthy_exit_codes": [0, 1],
      "owner": "Dev Agent (V061 staging)",
      "depends_on": ["172.20.59.7 reachable", "Lark app credentials"]
    },
    "alert_monitor_health": {
      "id": "alert_monitor_health",
      "version": "v007.86g",
      "script": "tools/check_alert_monitor_health.py",
      "task_name": "\\yonaa_alert_monitor_health",
      "interval_sec": 300,
      "purpose": "Layer 1 heartbeat: verify alert_monitor log/state within stale thresholds",
      "log_file": "tools/check_alert_monitor_health.log",
      "checks": [
        "log_exists (>200B, <10MB)",
        "log_recent (<10 min)",
        "heartbeat_present ([HEARTBEAT-V00786F] <10 min)",
        "no_error_patterns (Traceback/ERROR/FATAL)",
        "state_recent (last_heartbeat_ts <15 min)"
      ],
      "depends_on": ["alert_monitor"]
    },
    "auto_heal": {
      "id": "auto_heal",
      "version": "v007.86g",
      "script": "tools/auto_heal_scheduler.py",
      "task_name": "\\yonaa_auto_heal",
      "interval_sec": 300,
      "purpose": "Layer 2 self-healing: restart alert_monitor on failure, daemon fallback after 3 consecutive fails",
      "log_file": "tools/auto_heal.log",
      "state_file": "tools/auto_heal_state.json",
      "thresholds": {
        "max_heals_per_hour": 6,
        "cooldown_sec": 600,
        "daemon_fallback_after": 3
      },
      "depends_on": ["alert_monitor"]
    },
    "agent_health": {
      "id": "agent_health",
      "version": "v007.86h",
      "script": "tools/check_agent_health.py",
      "task_name": "\\yonaa_agent_health",
      "interval_sec": 300,
      "purpose": "Layer 3 agent self-health: verify Dev Agent operational (git status, plan tasks, infra manifest sync)",
      "log_file": "tools/check_agent_health.log",
      "state_file": "tools/check_agent_health_state.json",
      "checks": [
        "git_clean (no uncommitted >30 min)",
        "git_synced (not >24h ahead of origin)",
        "plan_tasks_healthy (all 3 yonaa_* tasks exit 0/1)",
        "manifest_in_sync (component scripts exist)",
        "agent_id_check (V007.80 §0.6 SOP)"
      ],
      "depends_on": ["alert_monitor", "alert_monitor_health", "auto_heal", "infra_manifest"]
    }
  },
  "alerts": {
    "im_type": "lark_app",
    "chat_id": "<from env LARK_CHAT_ID>",
    "cooldown_sec": 600,
    "at_all_on_fail": true,
