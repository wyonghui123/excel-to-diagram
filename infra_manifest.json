  "components": {
    "alert_monitor": {
      "id": "alert_monitor",
      "version": "v0760",
      "script": "tools/alert_monitor_v0760.py",
      "task_name": "\\yonaa_alert_monitor",
      "interval_sec": 300,
      "purpose": "Poll 7 remote services (172.20.59.7) every 5 min, push alerts to Feishu",
      "log_file": "tools/alert_monitor_v0760.log",
      "state_file": "tools/alert_monitor_config_state.json",
