[Unit]
Description=core_service - meta-capability service (upload + exec, HTTPS)
Documentation=file:///opt/app/shared/core_service.py
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/app/shared

# 用 miniconda python (有 _ssl + OpenSSL 3.0.9 模块)
ExecStart=/opt/miniconda3-py39/bin/python /opt/app/shared/core_service.py

# [V007.55 v1.4] HTTPS 环境变量 (证书部署在 /opt/app/shared/core_service.{crt,key})
Environment=CORE_SERVICE_SECRET=v007.52-core
Environment=CORE_SERVICE_SSL_CERTFILE=/opt/app/shared/core_service.crt
Environment=CORE_SERVICE_SSL_KEYFILE=/opt/app/shared/core_service.key

# 自动重启 (5 秒间隔)
Restart=always
RestartSec=5

# 资源限制
LimitNOFILE=65535

# 安全加固
NoNewPrivileges=yes
ProtectSystem=full
ProtectHome=read-only
PrivateTmp=yes

[Install]
WantedBy=multi-user.target